# ── 무료 (키 없음) ───────────────────────────────────────────
# Pollinations.ai 는 키도 가입도 필요 없다. 기본으로 켜져 있다.
# 끄려면 1로 설정.
DISABLE_POLLINATIONS=
POLLINATIONS_MODEL=flux

# ── 무료 티어 (가입만, 카드 불필요) ──────────────────────────
# Cloudflare Workers AI: 하루 10,000 뉴런 무료
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Google AI Studio 무료 티어
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── 유료 ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# 기본 provider 고정 (pollinations | cloudflare | gemini | openai | procedural)
IMAGE_PROVIDER=

# 프롬프트 정제용 (Claude는 이미지 생성 불가, 텍스트만)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
